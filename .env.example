# Document Extraction Service (FastAPI)
EXTRACTION_SERVICE_URL="http://localhost:8000"
DOCUMENT_EXTRACTION_SERVICE_URL="http://localhost:8000"

# High-Confidence Strict Hybrid RAG Engine Configuration
RAG_HIGH_CONFIDENCE_THRESHOLD="0.50"
RAG_MEDIUM_CONFIDENCE_THRESHOLD="0.25"
RAG_DEBUG="true"


