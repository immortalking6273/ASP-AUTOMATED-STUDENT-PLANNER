# Application Configuration
NEXT_PUBLIC_APP_NAME="Automated Student Planner"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Future Integration Placeholders

# Module 2: Authentication (Supabase Auth Placeholder)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Module 3: Database (Supabase PostgreSQL Placeholder)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Module 4: AI Engine (NVIDIA NIM Hosted API)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.3-70b-instruct"

# Legacy / Alternative AI Engine Placeholder
GROQ_API_KEY="gsk_your_groq_api_key_placeholder"
